-- HELPER FUNCTIONS
local function Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 12)
    c.Parent = obj
end

local function Border(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or CONFIG.GOLD
    s.Thickness = thickness or 1.5
    s.Parent = obj
    return s
end

local function MakeLabel(parent, text, height, size)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -20, 0, height or 35)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = CONFIG.WHITE
    l.Font = Enum.Font.GothamBold
    l.TextSize = size or 14
    l.TextWrapped = true
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

local function MakeButton(parent, text, height)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, height or 42)
    b.BackgroundColor3 = CONFIG.PURPLE
    b.Text = text
    b.TextColor3 = CONFIG.WHITE
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.Parent = parent
    Corner(b, 10)
    Border(b, CONFIG.GOLD)
    return b
end

